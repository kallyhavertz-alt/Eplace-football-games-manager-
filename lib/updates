import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'dart:convert';
import 'package:eplace/notification_service.dart';
import 'package:eplace/session_manager.dart';
import 'package:eplace/Efootbal_loader.dart';

class NotificationsScreen extends StatefulWidget {
  const NotificationsScreen({super.key});

  @override
  State<NotificationsScreen> createState() => _NotificationsScreenState();
}

class _NotificationsScreenState extends State<NotificationsScreen> {
  List<Map<String, dynamic>> _notifications = [];
  bool _isLoading = true;
  int? _userId;

  @override
  void initState() {
    super.initState();
    _loadLocalAndFetchNotifications();
  }

  Future<void> _loadLocalAndFetchNotifications() async {
    final userId = await SessionManager.getUserId();
    _userId = userId;

    // 1. Load locally saved notifications first
    final prefs = await SharedPreferences.getInstance();
    if (userId != null) {
      final cachedString = prefs.getString('cached_notifications_$userId');
      if (cachedString != null) {
        try {
          final List<dynamic> decoded = jsonDecode(cachedString);
          setState(() {
            _notifications = decoded.map((e) => Map<String, dynamic>.from(e)).toList();
            _sortNotifications();
            _isLoading = false;
          });
        } catch (e) {
          debugPrint('Error decoding cached notifications: $e');
        }
      }
    }

    // 2. Fetch from API in background/fresh
    if (userId != null) {
      final list = await NotificationService.fetchUserNotifications(userId);
      if (mounted && list.isNotEmpty) {
        final List<Map<String, dynamic>> mapped = list.map((e) => Map<String, dynamic>.from(e)).toList();
        setState(() {
          _notifications = mapped;
          _sortNotifications();
          _isLoading = false;
        });
        await _saveNotificationsLocally(userId, mapped);
      } else if (mounted) {
        setState(() => _isLoading = false);
      }
    } else {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  Future<void> _saveNotificationsLocally(int userId, List<Map<String, dynamic>> list) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('cached_notifications_$userId', jsonEncode(list));
  }

  void _sortNotifications() {
    _notifications.sort((a, b) {
      final timeA = DateTime.tryParse(a['created_at'] ?? a['createdAt'] ?? a['timestamp'] ?? '') ?? DateTime.fromMillisecondsSinceEpoch(0);
      final timeB = DateTime.tryParse(b['created_at'] ?? b['createdAt'] ?? b['timestamp'] ?? '') ?? DateTime.fromMillisecondsSinceEpoch(0);
      return timeB.compareTo(timeA); // Newest first
    });
  }

  Future<void> _handleMarkAsRead(int? notificationId, bool isRead) async {
    if (notificationId != null && !isRead) {
      await NotificationService.markAsRead(notificationId);
      setState(() {
        for (var item in _notifications) {
          if (item['id'] == notificationId) {
            item['read'] = true;
            item['isRead'] = true;
          }
        }
      });
      if (_userId != null) {
        await _saveNotificationsLocally(_userId!, _notifications);
      }
    }
  }

  void _showFullMessageDrawer(Map<String, dynamic> item) {
    final int? notificationId = item['id'];
    final bool isRead = item['read'] ?? item['isRead'] ?? false;
    final String title = item['title'] ?? 'Notification';
    final String message = item['message'] ?? item['body'] ?? '';
    final String timeStr = _formatTimestamp(item['created_at'] ?? item['createdAt'] ?? item['timestamp']);

    // Mark as read when viewing full message
    _handleMarkAsRead(notificationId, isRead);

    showModalBottomSheet(
      context: context,
      backgroundColor: const Color(0xFF1E1E1E).withValues(alpha: 0.95),
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) {
        return Padding(
          padding: EdgeInsets.only(
            left: 20,
            right: 20,
            top: 20,
            bottom: MediaQuery.of(context).viewInsets.bottom + 20,
          ),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Center(
                child: Container(
                  width: 40,
                  height: 4,
                  decoration: BoxDecoration(
                    color: Colors.grey[600],
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
              ),
              const SizedBox(height: 16),
              Row(
                children: [
                  Icon(
                    title.contains('Approved') || title.contains('Verified')
                        ? Icons.check_circle_outline
                        : Icons.notifications_active_outlined,
                    color: title.contains('Approved') || title.contains('Verified')
                        ? Colors.greenAccent
                        : Colors.blueAccent,
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      title,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 8),
              Text(
                timeStr,
                style: TextStyle(color: Colors.grey[400], fontSize: 12),
              ),
              const Divider(color: Colors.grey, height: 24),
              ConstrainedBox(
                constraints: const BoxConstraints(maxHeight: 300),
                child: SingleChildScrollView(
                  child: Text(
                    message,
                    style: const TextStyle(color: Colors.white70, fontSize: 15, height: 1.4),
                  ),
                ),
              ),
              const SizedBox(height: 20),
              SizedBox(
                width: double.infinity,
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.blueAccent,
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                  onPressed: () => Navigator.pop(context),
                  child: const Text('Close', style: TextStyle(color: Colors.white)),
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  String _formatTimestamp(dynamic rawTimestamp) {
    if (rawTimestamp == null) return '';
    final dt = DateTime.tryParse(rawTimestamp.toString());
    if (dt == null) return rawTimestamp.toString();
    final now = DateTime.now();
    if (dt.year == now.year && dt.month == now.month && dt.day == now.day) {
      return 'Today at ${_twoDigits(dt.hour)}:${_twoDigits(dt.minute)}';
    } else {
      return '${dt.year}-${_twoDigits(dt.month)}-${_twoDigits(dt.day)} ${_twoDigits(dt.hour)}:${_twoDigits(dt.minute)}';
    }
  }

  String _twoDigits(int n) => n.toString().padLeft(2, '0');

  @override
  Widget build(BuildContext context) {
    return Stack(
      children: [
        // Full screen background image
        Positioned.fill(
          child: Image.asset(
            'assets/screens.png',
            fit: BoxFit.cover,
            errorBuilder: (context, error, stackTrace) => Container(color: Colors.black),
          ),
        ),
        // Transparent Scaffold stacked on top
        Scaffold(
          backgroundColor: Colors.transparent,
          appBar: AppBar(
            title: const Text('Notifications', style: TextStyle(color: Colors.white)),
            backgroundColor: const Color(0xFF1E1E1E).withValues(alpha: 0.0),
            iconTheme: const IconThemeData(color: Colors.white),
            elevation: 0,
          ),
          body: _isLoading
              ? const Center(child: EFootballLoader(size: 64))
              : _notifications.isEmpty
              ? Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(Icons.notifications_off_outlined, size: 64, color: Colors.grey[400]),
                const SizedBox(height: 12),
                Text(
                  'No notifications yet',
                  style: TextStyle(color: Colors.grey[300], fontSize: 16),
                ),
              ],
            ),
          )
              : RefreshIndicator(
            onRefresh: _loadLocalAndFetchNotifications,
            color: Colors.blueAccent,
            child: ListView.builder(
              itemCount: _notifications.length,
              padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 4),
              itemBuilder: (context, index) {
                final item = _notifications[index];
                final bool isRead = item['read'] ?? item['isRead'] ?? false;
                final String title = item['title'] ?? 'Notification';
                final String message = item['message'] ?? item['body'] ?? '';
                final String timeStr = _formatTimestamp(item['created_at'] ?? item['createdAt'] ?? item['timestamp']);

                final bool isLong = message.length > 60;
                final String displayMessage = (isLong && !isRead)
                    ? '${message.substring(0, 60)}...'
                    : message;

                return Card(
                  color: isRead ? const Color(0xFF1E1E1E).withValues(alpha: 0.85) : const Color(0xFF2A2A3C).withValues(alpha: 0.9),
                  margin: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(10),
                    side: BorderSide(
                      color: isRead ? Colors.transparent : Colors.blueAccent.withValues(alpha: 0.6),
                      width: 1,
                    ),
                  ),
                  child: Padding(
                    padding: const EdgeInsets.all(12.0),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            CircleAvatar(
                              radius: 16,
                              backgroundColor: title.contains('Approved') || title.contains('Verified')
                                  ? Colors.green.withValues(alpha: 0.3)
                                  : Colors.red.withValues(alpha: 0.3),
                              child: Icon(
                                title.contains('Approved') || title.contains('Verified')
                                    ? Icons.check_circle_outline
                                    : Icons.error_outline,
                                size: 18,
                                color: title.contains('Approved') || title.contains('Verified')
                                    ? Colors.greenAccent
                                    : Colors.redAccent,
                              ),
                            ),
                            const SizedBox(width: 10),
                            Expanded(
                              child: Text(
                                title,
                                style: TextStyle(
                                  color: Colors.white,
                                  fontWeight: isRead ? FontWeight.normal : FontWeight.bold,
                                  fontSize: 15,
                                ),
                              ),
                            ),
                            if (timeStr.isNotEmpty)
                              Text(
                                timeStr,
                                style: TextStyle(color: Colors.grey[400], fontSize: 11),
                              ),
                          ],
                        ),
                        const SizedBox(height: 8),
                        Text(
                          displayMessage,
                          style: TextStyle(color: Colors.grey[200], fontSize: 13),
                        ),
                        const SizedBox(height: 4),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.end,
                          children: [
                            if (!isRead || isLong)
                              TextButton(
                                style: TextButton.styleFrom(
                                  padding: EdgeInsets.zero,
                                  minimumSize: const Size(50, 30),
                                  tapTargetSize: MaterialTapTargetSize.shrinkWrap,
                                ),
                                onPressed: () => _showFullMessageDrawer(item),
                                child: const Text(
                                  'read',
                                  style: TextStyle(color: Colors.blueAccent, fontWeight: FontWeight.bold, fontSize: 13),
                                ),
                              ),
                          ],
                        ),
                      ],
                    ),
                  ),
                );
              },
            ),
          ),
        ),
      ],
    );
  }
}
